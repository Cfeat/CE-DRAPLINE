{id=30,name="美味宝石山",category=1,regular=true,description="冷却 / 战斗中使用 所有处于冷却中的技能的冷却时间减少2回合"},
{id=31,name="大蜂巢",category=1,regular=true,description="[变量762] / 从背包使用 恢复20[变量762]"},
