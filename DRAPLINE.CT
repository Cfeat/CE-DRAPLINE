    local item = {record=record,key="gold",hint="0 到游戏资金上限；修改真实队伍资金。",editable=true}
    D.records[101] = item; D.records["gold"] = item
    record.OnGetDisplayValue = function()
      if not live() then return true, '--' end
      return true, tostring(D.state[item.key] or '--')
    end
  end
end
